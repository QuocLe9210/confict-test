<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Admin Login - Flower Shop</title>
<style>
    body { font-family: Arial, sans-serif; background-color: #f0e6e6; margin: 0; display: flex; justify-content: center; align-items: center; height: 100vh; }
    .login-card { background: #fff; padding: 40px; border-radius: 8px; box-shadow: 0 4px 15px rgba(165,61,23,0.1); width: 100%; max-width: 350px; }
    .login-card h2 { color: #a53d17; text-align: center; margin-top: 0; margin-bottom: 25px; font-size: 24px; }
    .form-group { margin-bottom: 20px; }
    .form-group label { display: block; margin-bottom: 8px; color: #555; font-weight: bold; font-size: 14px; }
    .form-group input { width: 100%; padding: 12px; border: 1px solid #ccc; border-radius: 4px; box-sizing: border-box; outline: none; transition: border-color 0.3s; }
    .form-group input:focus { border-color: #a53d17; }
    .btn-submit { width: 100%; padding: 12px; background-color: #a53d17; color: white; border: none; border-radius: 4px; font-size: 16px; cursor: pointer; font-weight: bold; transition: background-color 0.3s; }
    .btn-submit:hover { background-color: #8a3313; }
    .back-link { display: block; text-align: center; margin-top: 20px; color: #a53d17; text-decoration: none; font-size: 14px; }
    .back-link:hover { text-decoration: underline; }
</style>
</head>
<body>
    <div class="login-card">
        <h2>Admin System</h2>
        <form action="/admin/products" method="GET">
            <div class="form-group">
                <label>Username</label>
                <input type="text" name="username" required>
            
</body>
</html>